<Window x:Class="SnookerClub.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Snooker Club" Width="1280" Height="820" MinWidth="900" MinHeight="620" WindowStartupLocation="CenterScreen">
  <Grid Margin="32,24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,24">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Analysis" Click="OpenAnalysis" Margin="0,0,12,0"/><Button Content="Settings" Click="OpenSettings"/></StackPanel>
      <StackPanel Orientation="Horizontal"><Button Content="Dashboard" Click="OpenDashboard" Margin="0,0,12,0"/><Button Content="Inventory" Click="OpenInventory"/></StackPanel>
    </DockPanel>
    <Border Grid.Row="1" Background="#263329" CornerRadius="8" Padding="14,10" Margin="0,0,0,24">
      <TextBlock Text="M1 · Interface preview — session saving and billing will arrive in later milestones." Foreground="#D6DDC2" FontSize="13"/>
    </Border>
    <ContentControl x:Name="PageHost" Grid.Row="2"/>
    <DockPanel Grid.Row="3" Margin="0,20,0,0">
      <TextBlock Text="SNOOKER CLUB" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
      <TextBlock Text="Local desktop · Foundation preview" FontSize="12" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right"/>
    </DockPanel>
  </Grid>
</Window>
